#!/usr/bin/env bash
set -euo pipefail

INSTALL_DIR="${MIRA_SO101_HOME:-$HOME/.local/share/mira-so101}"
RUNTIME="$INSTALL_DIR/runtime.py"
PYTHON="$INSTALL_DIR/venv/bin/python"

[[ -x "$PYTHON" && -f "$RUNTIME" ]] || {
  printf 'Mira SO-101 core is not installed. Run install.sh from the bundle.\n' >&2
  exit 1
}
exec "$PYTHON" "$RUNTIME" "$@"
